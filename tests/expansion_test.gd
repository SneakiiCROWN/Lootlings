extends SceneTree

const Inventory = preload("res://inventory_system.gd")
const Forge = preload("res://forge_system.gd")
const Items = preload("res://item_catalog.gd")
const Campaign = preload("res://campaign_system.gd")

func _initialize() -> void:
	var inventory := Inventory.new()
	var original := inventory.equipped_item("Weapon").duplicate(true)
	assert(not Forge.purchase(inventory, 0, -1).ok)
	assert(inventory.equipped_item("Weapon") == original)
	inventory.scrap = 50
	var first := Forge.purchase(inventory, 1000, -1)
	assert(first.ok and first.gold == 820 and inventory.scrap == 42)
	assert(first.item.name == "Vaultcleaver" and first.item.id == original.id)
	assert(is_equal_approx(first.item.effects.damage_mult, original.effects.damage_mult + 0.04))
	var second := Forge.purchase(inventory, first.gold, -1)
	assert(second.ok and second.gold == 400 and inventory.scrap == 24)
	assert(second.item.name == "Crowncleaver" and Forge.stage(second.item) == 2)
	assert(not Forge.purchase(inventory, 10000, -1).ok)
	assert(not Forge.purchase(inventory, 10000, -2).ok)
	assert(not Forge.purchase(inventory, 10000, 999).ok)
	assert(inventory.save("user://forge_test.cfg") == OK)
	var restored := Inventory.new()
	restored.load("user://forge_test.cfg")
	assert(restored.equipped_item("Weapon") == inventory.equipped_item("Weapon"))
	assert(restored.scrap == 24)
	# Previous schema: migrate missing evolution without touching existing stats.
	var old := ConfigFile.new()
	var legacy_item := original.duplicate(true)
	legacy_item.erase("evolution_stage")
	old.set_value("inventory", "version", 2)
	old.set_value("inventory", "equipped", {"Weapon":legacy_item})
	old.set_value("inventory", "stash", [Items.create_item("bonebow", "EPIC", 27)])
	assert(old.save("user://forge_v2.cfg") == OK)
	restored.load("user://forge_v2.cfg")
	assert(Forge.stage(restored.equipped_item("Weapon")) == 0)
	assert(restored.equipped_item("Weapon").effects == original.effects)
	restored.scrap = 50
	assert(Forge.purchase(restored, 1000, 0).ok)
	assert(restored.stash[0].name == "Ruin Longbow")
	assert(restored.stash[0].rarity == "EPIC" and restored.stash[0].serial == 27)
	assert(restored.save("user://forge_partial.cfg") == OK)
	inventory.load("user://forge_partial.cfg")
	assert(Forge.stage(inventory.stash[0]) == 1)
	var campaign := Campaign.new()
	assert(campaign.available("act_i") and not campaign.available("mossglass_wilds"))
	campaign.finish("first_hoard")
	assert(campaign.completed.is_empty())
	for id in Campaign.ORDER:
		assert(campaign.available(id))
		for wave in range(1, 16):
			var zone := Campaign.zone_for(id, wave)
			assert(zone.has("enemies") and zone.has("background") and zone.compositions.size() == 5)
		for item_id in Campaign.LOOT_POOLS.get(id, []):
			assert(not Items.definition(item_id).is_empty())
		if Campaign.REGIONAL_VARIANTS.has(id):
			assert(not preload("res://enemy_variant_catalog.gd").definition(Campaign.REGIONAL_VARIANTS[id]).is_empty())
		campaign.finish(id)
	assert(campaign.save("user://campaign_test.cfg") == OK)
	var loaded := Campaign.new()
	loaded.load_progress("user://campaign_test.cfg")
	assert(loaded.completed == campaign.completed)
	loaded.load_progress("user://campaign_missing.cfg")
	assert(loaded.completed.is_empty() and loaded.available("act_i"))
	inventory.reset_to_starter()
	inventory.scrap = 100
	var gold := 3000
	for weapon_type in Forge.WeaponCatalog.STARTERS:
		var purchase := Forge.craft(inventory, gold, weapon_type, 123)
		assert(purchase.ok and purchase.item.weapon_type == weapon_type and purchase.item.temp_art)
		assert(purchase.item.evolution_path.size() == 2)
		gold = purchase.gold
	assert(inventory.stash.size() == 7 and gold == 1950 and inventory.scrap == 58)
	assert(not Forge.craft(inventory, gold, "bad_id", 124).ok)
	assert(not Forge.craft(inventory, 0, "spear", 124).ok)
	assert(inventory.save("user://new_weapons.cfg") == OK)
	restored.load("user://new_weapons.cfg")
	assert(restored.stash == inventory.stash)
	while inventory.stash.size() < inventory.stash_capacity:
		inventory.keep(Items.create_item("bonebow", "COMMON", 123))
	assert(not Forge.craft(inventory, gold, "orb", 124).ok)
	var ranger: Texture2D = load("res://art/sprites/weapons/ranger_bow.png")
	var mage: Texture2D = load("res://art/sprites/weapons/mage_staff.png")
	assert(Forge.WeaponCatalog.runtime_texture("", ranger) == ranger)
	assert(Forge.WeaponCatalog.runtime_texture("", mage) == mage)
	print("EXPANSION PASSED: Forge costs, cap, insufficient funds, bounds, equipped/stash, v2 migration and partial reload")
	print("CAMPAIGN PASSED: ten entries, sequential unlocks, no locked completion, all waves, persistence, fresh save")
	quit(0)
