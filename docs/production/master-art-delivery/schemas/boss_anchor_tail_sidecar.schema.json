{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "boss_anchor_tail artist metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attack_name",
    "phase",
    "hip_root",
    "mouth_or_emitter",
    "contact_point",
    "effect_origin",
    "tail_root",
    "tail_tip",
    "tail_centreline",
    "tail_thickness_samples",
    "tail_count"
  ],
  "properties": {
    "attack_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "phase": {
      "type": "string"
    },
    "hip_root": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "null"
        }
      ]
    },
    "mouth_or_emitter": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "null"
        }
      ]
    },
    "contact_point": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "null"
        }
      ]
    },
    "effect_origin": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "null"
        }
      ]
    },
    "tail_root": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "null"
        }
      ]
    },
    "tail_tip": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "null"
        }
      ]
    },
    "tail_centreline": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 2,
        "maxItems": 2
      }
    },
    "tail_thickness_samples": {
      "type": "array",
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "tail_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    }
  },
  "description": "Use as nested contacts/attack_anchors/tail in the actor sidecar where applicable; companion/environment/support standalone. This is not current engine JSON schema."
}
