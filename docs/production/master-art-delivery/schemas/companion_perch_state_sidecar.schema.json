{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "companion_perch_state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entity_id",
    "state",
    "facing",
    "canvas",
    "baseline_y",
    "pivot",
    "runtime_size",
    "cosmetic_only",
    "ground_or_hover_point",
    "body_filename",
    "source_sha256",
    "perch_contact_anchor",
    "perch_anchor_type",
    "allowed_slots",
    "interaction_prop_path",
    "interaction_contact_anchor"
  ],
  "properties": {
    "entity_id": {
      "enum": [
        "auricub",
        "stonekith",
        "pixrask",
        "lunarwisp",
        "puffnest",
        "breezewyn"
      ]
    },
    "state": {
      "enum": [
        "perch_rest",
        "perch_interact"
      ]
    },
    "facing": {
      "enum": [
        "right",
        "left"
      ]
    },
    "canvas": {
      "const": [
        256,
        256
      ]
    },
    "baseline_y": {
      "const": 224
    },
    "pivot": {
      "const": [
        128,
        224
      ]
    },
    "runtime_size": {
      "const": [
        56,
        56
      ]
    },
    "cosmetic_only": {
      "const": true
    },
    "ground_or_hover_point": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "body_filename": {
      "type": "string"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "perch_contact_anchor": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "perch_anchor_type": {
      "enum": [
        "actual_supporting_anatomy_boundary",
        "hover_reference"
      ]
    },
    "allowed_slots": {
      "type": "array",
      "items": {
        "enum": [
          "home.floor_perch",
          "home.wall_perch"
        ]
      },
      "minItems": 1
    },
    "interaction_prop_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "interaction_contact_anchor": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "description": "New artist interchange; final numeric anchors measured from delivered pixels, no unresolved template markers."
}
