{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "enemy_attack_anchor artist metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attack_name",
    "phase",
    "mouth_or_emitter",
    "contact_point",
    "effect_origin",
    "look_target",
    "ground_or_hover"
  ],
  "properties": {
    "attack_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "phase": {
      "type": "string"
    },
    "mouth_or_emitter": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "null"
        }
      ]
    },
    "contact_point": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "null"
        }
      ]
    },
    "effect_origin": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "null"
        }
      ]
    },
    "look_target": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "null"
        }
      ]
    },
    "ground_or_hover": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    }
  },
  "description": "Use as nested contacts/attack_anchors/tail in the actor sidecar where applicable; companion/environment/support standalone. This is not current engine JSON schema."
}
